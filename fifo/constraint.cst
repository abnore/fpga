// ============================================================================
// TANG NANO 9K | MASTER PIN CONSTRAINTS
// GW1NR-LV9QN88PC6/I5
// ============================================================================
// Uncomment both lines of a pin and rename both ports to match your RTL.
// Keep IO_LOC and IO_PORT on separate lines for nextpnr compatibility.

// --- CLOCK ----------------------------------------------------------------
// 27 MHz oscillator; input only.
IO_LOC  "clk"          52;
IO_PORT "clk"          IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- BUTTONS --------------------------------------------------------------
IO_LOC  "cnt_n"      3;
IO_PORT "cnt_n"     IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "rst_n"       4;
IO_PORT "rst_n"      IO_TYPE=LVCMOS18 PULL_MODE=UP;

// --- LEDS -----------------------------------------------------------------
// Active LOW; 1.8 V.
IO_LOC  "led[0]"       10;
IO_PORT "led[0]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[1]"       11;
IO_PORT "led[1]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[2]"       13;
IO_PORT "led[2]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[3]"       14;
IO_PORT "led[3]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[4]"       15;
IO_PORT "led[4]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[5]"       16;
IO_PORT "led[5]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;

IO_LOC  "seg[0]"       56;
IO_PORT "seg[0]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "seg[1]"       57; 
IO_PORT "seg[1]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "seg[5]"       68;
IO_PORT "seg[5]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "seg[6]"       69;
IO_PORT "seg[6]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "seg[2]"       49;
IO_PORT "seg[2]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "seg[3]"       31;
IO_PORT "seg[3]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "seg[4]"       32;
IO_PORT "seg[4]"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "wr"           54;
IO_PORT "wr"           IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "rd"           55;
IO_PORT "rd"           IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "red"          71;
IO_PORT "red"          IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "green"        70;
IO_PORT "green"        IO_TYPE=LVCMOS33 PULL_MODE=NONE;
