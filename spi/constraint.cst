// ============================================================================
// TANG NANO 9K | MASTER PIN CONSTRAINTS
// GW1NR-LV9QN88PC6/I5
// ============================================================================
// Uncomment both lines of a pin and rename both ports to match your RTL.
// Keep IO_LOC and IO_PORT on separate lines for nextpnr compatibility.
// IO_LOC = FPGA package pin; j5_01 = connector J5, position 1.
// Each user pin appears once. Shared functions are labelled beside the pin.
// Fixed bank voltages: 3.3 V / 1.8 V as listed. FPGA I/O is NOT 5 V tolerant.
// Shared pins remain wired to onboard circuits; avoid conflicting accessories.
// Source: Sipeed Tang_Nano_9k_3672_Schematic.pdf (revision history 6202).

// --- CLOCK ----------------------------------------------------------------
// 27 MHz oscillator; input only.
IO_LOC  "clk"          52;
IO_PORT "clk"          IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- LEDS -----------------------------------------------------------------
// Active LOW; 1.8 V.
// IO_LOC  "led[0]"       10;
// IO_PORT "led[0]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
// IO_LOC  "led[1]"       11;
// IO_PORT "led[1]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
// IO_LOC  "led[2]"       13;
// IO_PORT "led[2]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
// IO_LOC  "led[3]"       14;
// IO_PORT "led[3]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
// IO_LOC  "led[4]"       15;
// IO_PORT "led[4]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;
// IO_LOC  "led[5]"       16;
// IO_PORT "led[5]"       IO_TYPE=LVCMOS18 PULL_MODE=NONE;

// --- BUTTONS --------------------------------------------------------------
// Active LOW; 1.8 V. S1/S2 labels vary by revision.
// IO_LOC  "button_n"      3;
// IO_PORT "button_n"     IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "rst"       4; // Also configuration/JTAG select
IO_PORT "rst"      IO_TYPE=LVCMOS18 PULL_MODE=UP;

// --- USB-UART -------------------------------------------------------------
// TX/RX directions are from the FPGA viewpoint.
// IO_LOC  "uart_tx"      17; // FPGA -> USB bridge
// IO_PORT "uart_tx"      IO_TYPE=LVCMOS33 PULL_MODE=UP;
// IO_LOC  "uart_rx"      18; // USB bridge -> FPGA
// IO_PORT "uart_rx"      IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- SPI FLASH ------------------------------------------------------------
// Enable user MSPI pins in the tool/packing configuration.
// IO_LOC  "flash_clk"    59;
// IO_PORT "flash_clk"    IO_TYPE=LVCMOS33 PULL_MODE=UP;
// IO_LOC  "flash_cs_n"   60;
// IO_PORT "flash_cs_n"   IO_TYPE=LVCMOS33 PULL_MODE=UP;
// IO_LOC  "flash_mosi"   61;
// IO_PORT "flash_mosi"   IO_TYPE=LVCMOS33 PULL_MODE=UP;
// IO_LOC  "flash_miso"   62;
// IO_PORT "flash_miso"   IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- LCD CONNECTORS -------------------------------------------------------
// Signals not present on J5/J6; remaining LCD signals are listed under the headers.
// IO_LOC  "lcd_resetn"   47; // P2.3: SPI LCD reset
// IO_PORT "lcd_resetn"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// IO_LOC  "touch_yu"     50; // J4.40: touch YU; digital I/O, not an ADC input
// IO_PORT "touch_yu"     IO_TYPE=LVCMOS33 PULL_MODE=NONE;

