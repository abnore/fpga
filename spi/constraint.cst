// --- J6 | GPIO HEADER -----------------------------------------------------
// Mixed 3.3 V / 1.8 V GPIOs and power pins; positions follow schematic numbering.
// J6.02..09 are 1.8 V. HDMI pins have onboard loading/pull-ups.
// IO_LOC  "j6_01"        63; // 3.3 V; J4 touch XL
// IO_PORT "j6_01"        IO_TYPE=LVCMOS33 PULL_MODE=NONE;
